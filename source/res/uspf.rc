// USPF resources: icon, manifest, the web UI, and the files it installs.
#include <windows.h>
1 ICON "uspf.ico"
1 RT_MANIFEST "uspf.manifest"

WEB_INDEX       RCDATA "../web/index.html"
WEB_APP_JS      RCDATA "../web/app.js"
WEB_APP_CSS     RCDATA "../web/app.css"
WEB_UPLOT_JS    RCDATA "../web/uPlot.iife.min.js"
WEB_UPLOT_CSS   RCDATA "../web/uPlot.min.css"
WEB_LOGO        RCDATA "../web/logo.svg"
D3D12_DLL       RCDATA "../payload/d3d12.dll"
D3D12ASYNC_INI  RCDATA "../payload/d3d12async.ini"
WEBVIEW2_LOADER RCDATA "../third_party/webview2/WebView2Loader.dll"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Meower"
      VALUE "FileDescription", "USPF - Unreal shader proxy fix"
      VALUE "FileVersion", "0.3.0"
      VALUE "InternalName", "USPF"
      VALUE "LegalCopyright", "(c) 2026 Meower. MIT License."
      VALUE "OriginalFilename", "USPF.exe"
      VALUE "ProductName", "USPF"
      VALUE "ProductVersion", "0.3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
